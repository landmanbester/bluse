# ---- data ------------------------------------------------------------------
# 21 GB of HDF5 supplied by the BLUSE team. Never commit.
aug_2026_workshop/data/

# ---- environments ----------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ---- generated outputs -----------------------------------------------------
# Parquet catalogues: ~105 MB, deterministic, regenerated in ~20 s by
#   bluse-track-a
# The .csv cut-flows and survivor lists ARE tracked -- they are the record of
# results and total ~1 MB.
aug_2026_workshop/catalogues/*.parquet

# Per-hit clustering outputs. The tracked record in clusters/ is deliberately
# SMALL -- the largest CSV in it is 178 KB -- because it is a record of results,
# not a data store. A full-file run writes far more than that: lband_short's
# interesting.csv alone is 17.6 MB, 100x the largest tracked CSV, and adding it
# would have nearly doubled a 31 MB repository with per-hit sky coordinates.
# Commit the small aggregates (<name>_families.csv, <name>_summary.csv from a
# sampled run) and regenerate the rest.
aug_2026_workshop/clusters/*_candidates.csv
aug_2026_workshop/clusters/*_metrics.json

# Track E scores. Same rule as clusters/: the tracked record is the RESULT, not
# the data store. all_scores.parquet is 32 MB of per-hit score and
# ambiguous.csv is 68 MB of the 3-31 beam population -- both regenerate in
# ~40 s from `bluse-score --no-report`. candidates.csv (4,565 Track A
# survivors, ranked), contrarian.csv and report.json ARE tracked: together
# ~1.3 MB, and they are what the last day of the workshop produced.
aug_2026_workshop/scores/all_scores.parquet
aug_2026_workshop/scores/ambiguous.csv
# Intermediate injection runs. `bluse-inject --tag X` writes X_injections.parquet
# for a comparison arm; only the canonical scores/injections.parquet is tracked,
# and each tracked row carries hit-level identifiers on a PUBLIC repository, so
# there is no reason to keep supersets of the same data around.
aug_2026_workshop/scores/*_injections.parquet
aug_2026_workshop/scores/injections_fluctuating.parquet

# Plots are regenerated on demand by bluse-explore.
aug_2026_workshop/plots/

# ---- reference PDFs --------------------------------------------------------
# ~30 MB of published papers, all retrievable by the arXiv IDs recorded in
# papers/*.md. Delete this line if you want the repo self-contained.
papers/*.pdf

# ---- build artefacts -------------------------------------------------------
# uv.lock is deliberately NOT ignored: it pins the resolution everyone installs.
dist/
build/
*.egg-info/

# ---- misc ------------------------------------------------------------------
.DS_Store
*.swp

# Track B feature matrices: ~700 MB, regenerated by bluse-features (~7 min).
aug_2026_workshop/features/
aug_2026_workshop/clusters/*.parquet
aug_2026_workshop/data/filtered_hits.csv
